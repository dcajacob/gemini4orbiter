 // ==============================================================
 
+void Vessel::SetPropagator (int &plevel, int &nstep) const
+{
+	VesselBase::SetPropagator(plevel, nstep);
+	if (!bSurfaceContact || !bDynamicGroundContact)
+		return;
+
+	const double minPMI = std::min({pmi.x, pmi.y, pmi.z});
+	if (mass <= 0.0 || minPMI <= 0.0)
+		return;
+
+	// A contact force also rotates the vessel about its centre of mass.
+	// Bound the spring and damping rates using that point's maximum
+	// effective inverse mass, summed over the possible contacts.
+	double stiffnessRateSquared = 0.0;
+	double dampingRate = 0.0;
+	for (oapi::UInt32 i = 0; i < ntouchdown_vtx; ++i) {
+		const auto &point = touchdown_vtx[i];
+		const double inverseMass = (1.0 + point.pos.length2()/minPMI)/mass;
+		stiffnessRateSquared += std::max(0.0, point.stiffness)*inverseMass;
+		dampingRate += std::max(0.0, point.damping)*inverseMass;
+	}
+
+	// Use at least one sample per spring radian and per two damping time
+	// constants, with a bounded extra cost during time acceleration.
+	constexpr double maxAdaptiveSubsteps = 128.0;
+	const double rate = std::max(std::sqrt(stiffnessRateSquared), dampingRate/2.0);
+	const double required = GetRigidBodyServices().Time().SimDT * rate;
+	nstep = std::max(nstep, static_cast<int>(std::ceil(std::min(required, maxAdaptiveSubsteps))));
+}
